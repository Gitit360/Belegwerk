{
  "name": "belegwerk",
  "private": true,
  "version": "0.1.0",
  "description": "Belegwerk – local-first Mac bookkeeping (scaffold)",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --filter @belegwerk/desktop dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "fmt:rust": "cargo fmt --all",
    "tauri:dev": "pnpm --filter @belegwerk/desktop tauri:dev",
    "tauri:build": "pnpm --filter @belegwerk/desktop tauri:build"
  },
  "engines": {
    "node": ">=20"
  }
}
